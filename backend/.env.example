# Copy this file to .env and fill in real values. Do NOT commit .env to version control.
# Example environment variables for SKY NORA TRAVELS backend
PORT=8080
MONGOOSE_DB_URL=mongodb://127.0.0.1:27017/skynora
# Use a strong secret in production. Rotate periodically.
JWT_SECRET_KEY=your_jwt_secret_here
# Optional: separate refresh token secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
# Twilio (optional) - fill only if using SMS OTP in production
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_auth_token
SERVICE_ID=VAXxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Duffel Air (server-side only; do not expose this to the frontend)
DUFFEL_ACCESS_TOKEN=duffel_test_your_access_token
