# Copy to .env and fill in real values. Never commit .env.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=60
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
MONGOOSE_DB_URL=mongodb://127.0.0.1:27017/skynora

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# ── Twilio OTP (optional) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API Key auth (recommended) — Console → Account → API keys & tokens
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
# Or legacy primary auth token
TWILIO_AUTH_TOKEN=your_auth_token
# Verify service — Console → Verify → Services (starts with VA...)
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AI Orchestrator (required for /ai-travel) ───────────────────────────────
# Gemini is preferred if both are set
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional Anthropic fallback
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Live travel data providers ────────────────────────────────────────────────
# Set REQUIRE_LIVE_DATA=true to disable mock fallbacks in development
REQUIRE_LIVE_DATA=false

# Flights & Hotels (Amadeus — enterprise only since July 2025)
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_ENV=test

# Free external fixtures when Amadeus is not set (no API key needed)
USE_EXTERNAL_FLIGHT_API=true
USE_EXTERNAL_HOTEL_API=true
RANDOMAPI_BASE_URL=https://randomapi.dev
MOCKDATA_BASE_URL=https://www.mockdata.dev

# Alternative flight search (legacy booking UI)
DUFFEL_ACCESS_TOKEN=duffel_test_your_access_token

# Maps, restaurants, attractions, directions
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Weather forecasts
OPENWEATHER_API_KEY=your_openweather_api_key

# Currency exchange rates
EXCHANGE_RATES_API_KEY=your_exchangerates_api_key

# Web search (visa, advisories, opening hours)
TAVILY_API_KEY=your_tavily_api_key

# Flight status (during-trip assistance)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
